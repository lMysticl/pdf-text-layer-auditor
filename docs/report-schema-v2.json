{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lMysticl/pdf-text-layer-auditor/main/docs/report-schema-v2.json",
  "title": "PDF Text Layer Auditor report v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "file",
    "fileSizeBytes",
    "pageCount",
    "inspectedPageCount",
    "encrypted",
    "extractionAllowed",
    "tinyTextThresholdPoints",
    "parseHealth",
    "completeness",
    "needsAttention",
    "pagesNeedingAttention",
    "pages"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "file": { "type": "string" },
    "fileSizeBytes": { "type": "integer", "minimum": 0 },
    "pageCount": { "type": "integer", "minimum": 0 },
    "inspectedPageCount": { "type": "integer", "minimum": 0 },
    "encrypted": { "type": "boolean" },
    "extractionAllowed": { "type": "boolean" },
    "tinyTextThresholdPoints": { "type": "number", "minimum": 0 },
    "parseHealth": { "$ref": "#/$defs/parseHealth" },
    "completeness": { "$ref": "#/$defs/completeness" },
    "needsAttention": { "type": "boolean" },
    "pagesNeedingAttention": { "type": "integer", "minimum": 0 },
    "pages": {
      "type": "array",
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "parseHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "recovered", "diagnostics"],
      "properties": {
        "complete": { "type": "boolean" },
        "recovered": { "type": "boolean" },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" }
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "pageNumber", "fontName"],
      "properties": {
        "code": {
          "type": "string",
          "enum": ["MALFORMED_TOUNICODE_CMAP", "INVALID_TOUNICODE_CMAP"]
        },
        "pageNumber": { "type": "integer", "minimum": 1 },
        "fontName": { "type": "string" }
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pageContent",
        "formXObjects",
        "semanticMappings",
        "readingOrder",
        "geometryVisibility",
        "annotations",
        "optionalContent"
      ],
      "properties": {
        "pageContent": { "type": "boolean" },
        "formXObjects": { "type": "boolean" },
        "semanticMappings": { "type": "boolean" },
        "readingOrder": { "type": "boolean" },
        "geometryVisibility": { "type": "boolean" },
        "annotations": { "type": "boolean" },
        "optionalContent": { "type": "boolean" }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pageNumber",
        "glyphCount",
        "unicodeCharacterCount",
        "missingUnicodeGlyphCount",
        "replacementCharacterCount",
        "tinyTextGlyphCount",
        "classification",
        "textSurfaces",
        "semanticMapping",
        "readingOrder",
        "geometryVisibility",
        "needsAttention",
        "fonts",
        "findings"
      ],
      "properties": {
        "pageNumber": { "type": "integer", "minimum": 1 },
        "glyphCount": { "type": "integer", "minimum": 0 },
        "unicodeCharacterCount": { "type": "integer", "minimum": 0 },
        "missingUnicodeGlyphCount": { "type": "integer", "minimum": 0 },
        "replacementCharacterCount": { "type": "integer", "minimum": 0 },
        "tinyTextGlyphCount": { "type": "integer", "minimum": 0 },
        "classification": {
          "type": "string",
          "enum": [
            "UNKNOWN",
            "BLANK",
            "VECTOR_ONLY",
            "IMAGE_ONLY",
            "NATIVE_TEXT",
            "MIXED",
            "SPARSE_OCR"
          ]
        },
        "textSurfaces": { "$ref": "#/$defs/textSurfaces" },
        "semanticMapping": { "$ref": "#/$defs/semanticMapping" },
        "readingOrder": { "$ref": "#/$defs/readingOrder" },
        "geometryVisibility": { "$ref": "#/$defs/geometryVisibility" },
        "needsAttention": { "type": "boolean" },
        "fonts": {
          "type": "array",
          "items": { "$ref": "#/$defs/font" }
        },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding" }
        }
      }
    },
    "textSurfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pageContentGlyphCount",
        "formXObjectGlyphCount",
        "actualTextGlyphCount",
        "actualTextCharacterCount"
      ],
      "properties": {
        "pageContentGlyphCount": { "type": "integer", "minimum": 0 },
        "formXObjectGlyphCount": { "type": "integer", "minimum": 0 },
        "actualTextGlyphCount": { "type": "integer", "minimum": 0 },
        "actualTextCharacterCount": { "type": "integer", "minimum": 0 }
      }
    },
    "semanticMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawMappedGlyphCount",
        "rawUnmappedGlyphCount",
        "actualTextResolvedGlyphCount",
        "malformedToUnicodeFontCount"
      ],
      "properties": {
        "rawMappedGlyphCount": { "type": "integer", "minimum": 0 },
        "rawUnmappedGlyphCount": { "type": "integer", "minimum": 0 },
        "actualTextResolvedGlyphCount": { "type": "integer", "minimum": 0 },
        "malformedToUnicodeFontCount": { "type": "integer", "minimum": 0 }
      }
    },
    "readingOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessed",
        "diverges",
        "streamCharacterCount",
        "positionCharacterCount"
      ],
      "properties": {
        "assessed": { "type": "boolean" },
        "diverges": { "type": "boolean" },
        "streamCharacterCount": { "type": "integer", "minimum": 0 },
        "positionCharacterCount": { "type": "integer", "minimum": 0 }
      }
    },
    "geometryVisibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessed",
        "invisibleGlyphCount",
        "offPageGlyphCount",
        "clippedGlyphCount",
        "transparentGlyphCount"
      ],
      "properties": {
        "assessed": { "type": "boolean" },
        "invisibleGlyphCount": { "type": ["integer", "null"], "minimum": 0 },
        "offPageGlyphCount": { "type": ["integer", "null"], "minimum": 0 },
        "clippedGlyphCount": { "type": ["integer", "null"], "minimum": 0 },
        "transparentGlyphCount": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "font": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "embedded", "damaged", "glyphCount"],
      "properties": {
        "name": { "type": "string" },
        "embedded": { "type": "boolean" },
        "damaged": { "type": "boolean" },
        "glyphCount": { "type": "integer", "minimum": 0 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "description"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "NO_TEXT_LAYER",
            "MISSING_UNICODE",
            "REPLACEMENT_CHARACTERS",
            "TINY_TEXT",
            "MALFORMED_TOUNICODE_CMAP",
            "INVALID_TOUNICODE_CMAP",
            "READING_ORDER_DIVERGENCE"
          ]
        },
        "description": { "type": "string" }
      }
    }
  }
}
